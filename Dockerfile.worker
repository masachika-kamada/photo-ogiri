FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    HF_HOME=/models/huggingface
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
RUN uv sync --frozen --no-dev --group ai && \
    /app/.venv/bin/python -c "from transformers import AutoModel, AutoProcessor; name='google/siglip2-base-patch16-224'; AutoProcessor.from_pretrained(name); AutoModel.from_pretrained(name)"
CMD ["/app/.venv/bin/photo-ogiri-worker"]